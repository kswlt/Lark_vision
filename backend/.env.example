# =========================================================
# 飞书配置（复制为 .env 后填写，绝不提交到 Git）
# 复制方法：cp backend/.env.example backend/.env
# =========================================================

# 数据源模式（显式声明，绝不自动回退 Mock）：
#   feishu -> 连接真实飞书（默认）。飞书失败时返回最近成功缓存并标记 stale，
#             从未成功过则返回明确错误/空态，绝不偷偷生成 Mock 假数据。
#   mock   -> 演示数据（开发 / 开源演示，不连飞书）。
DATA_SOURCE=feishu

# 应用凭证（开放平台 -> 应用 -> 凭证与基础信息）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 任务多维表格
FEISHU_APP_TOKEN=
FEISHU_TABLE_ID=

# 打卡/工时多维表格（来源 A：团队在表格里记录上下班时间）
FEISHU_WORKTIME_APP_TOKEN=
FEISHU_WORKTIME_TABLE_ID=

# 工时来源：bitable | attendance | mock
#   bitable   -> 从 FEISHU_WORKTIME_* 读上下班打卡记录
#   attendance-> 调用飞书考勤 API（需"导出打卡数据"权限）
#   mock      -> 使用演示数据
FEISHU_WORKTIME_SOURCE=mock

# 管理接口鉴权 Token（/api/admin/* 需要 Authorization: Bearer <ADMIN_TOKEN>）
# 生产环境请设置强随机值：python -c "import secrets; print(secrets.token_hex(24))"
ADMIN_TOKEN=

# 服务
PORT=8080
HOST=0.0.0.0

# =========================================================
# 摄像头 / 人脸识别（可选，缺省禁用）
# =========================================================
# 是否启用摄像头（false 时人脸签到自动隐藏/禁用）
CAMERA_ENABLED=false
# 华睿 SDK 的 CTI 文件路径（安装「华睿 MV Viewer」后定位，例如 C:\Program Files\HuarayTech\...\GenTL_Python\...cti）
CAMERA_CTI_PATH=
# 本地数据/人脸库目录（默认 backend/data / backend/face_library）
APP_DATA_DIR=
FACE_LIBRARY_DIR=
# 摄像头视频流服务内部地址（预览帧对外服务，默认 http://127.0.0.1:18080）
CAMERA_INTERNAL_URL=http://127.0.0.1:18080
